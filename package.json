{
  "name": "@vaakx-dev/vrui",
  "version": "0.1.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaakx-dev/vrui.git"
  },
  "homepage": "https://github.com/vaakx-dev/vrui#readme",
  "bugs": {
    "url": "https://github.com/vaakx-dev/vrui/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "docs",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && rollup -c",
    "check": "npm run typecheck && npm test && npm run examples:check && npm run build",
    "example:tasks": "vite examples/tasks --config examples/vite.config.mjs",
    "example:tasks:build": "vite build examples/tasks --config examples/vite.config.mjs --outDir ../../.examples-dist/tasks",
    "example:workshop": "vite examples/workshop --config examples/vite.config.mjs",
    "example:workshop:build": "vite build examples/workshop --config examples/vite.config.mjs --outDir ../../.examples-dist/workshop",
    "examples:build": "npm run example:tasks:build && npm run example:workshop:build",
    "examples:check": "npm run examples:typecheck && npm run examples:style && npm run examples:build",
    "examples:style": "node scripts/check_application_style.mjs",
    "examples:typecheck": "tsc -p tsconfig.examples.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "happy-dom": "^20.9.0",
    "lucide": "^1.16.0",
    "rollup": "^4.62.0",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "lucide": "^1.16.0"
  }
}
